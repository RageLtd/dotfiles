[gpg]
	format = ssh
[commit]
	gpgsign = true
	template = {{ .chezmoi.homeDir }}/.stCommitMsg
[user]
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFYYXTvcmOhotsCanioNrhSpXztzF3Bu9T+f6G1d8IKR
	name = RageLtd
	email = github@rageltd.ca
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[core]
	pager = delta
	excludesfile = {{ .chezmoi.homeDir }}/.gitignore_global
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	dark = true
	side-by-side = false
	syntax-theme = OneHalfDark
	features = decorations
	file-style = bold yellow ul
	hunk-header-style = file line-number syntax
[url "ssh://git@github.com/"]
	insteadOf = https://github.com/
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[gpg "ssh"]
{{- if eq .chezmoi.os "darwin" }}
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
{{- else if stat "/opt/1Password/op-ssh-sign" }}
	program = /opt/1Password/op-ssh-sign
{{- end }}
{{- /* no 1Password (e.g. DGX OS): git's default ssh-keygen signs via the forwarded agent */}}
