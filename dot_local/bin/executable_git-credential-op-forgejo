#!/bin/sh
# git credential helper backed by 1Password (op CLI).
# Expects a 1P item "forgejo-git" with fields "username" and "credential".
# Wired to git.rageltd.ca via [credential] block in .gitconfig.
set -eu

OP_ITEM="op://Private/forgejo-git"

case "${1:-}" in
  get)
    printf 'username=%s\n' "$(op read "$OP_ITEM/username")"
    printf 'password=%s\n' "$(op read "$OP_ITEM/credential")"
    ;;
  *)
    # store/erase are no-ops: 1P is the source of truth, git caches nothing.
    exit 0
    ;;
esac
