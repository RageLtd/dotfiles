# OS files
.DS_Store
**/.DS_Store

# Claude Code local files (user-specific, not for version control)
*.local.json
*.local.md
.claude/*.local.*

# Editor backups
*_backup*
*.bak
*.swp
*~

# Secrets (should never be committed)
.env
.env.*

# History
history.txt

# Nushell vendor autoload (generated by config.nu at startup)
dot_config/nushell/vendor/

# Zed prompts DB
dot_config/zed/prompts
