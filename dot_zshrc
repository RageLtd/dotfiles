# .zshrc - Interactive shell configuration

# =============================================================================
# PATH Configuration (consolidated)
# =============================================================================
typeset -U PATH  # Deduplicate PATH entries

# User paths. Toolchains come from brew (see Brewfile). ~/.cargo/bin, ~/go/bin
# and ~/.bun/bin hold `cargo install` / `go install` / `bun i -g` binaries.
path=(
    $HOME/.local/bin
    $HOME/.cargo/bin
    $HOME/go/bin
    $HOME/.bun/bin
    $HOME/.opencode/bin
    $HOME/bin
    $path
)

# =============================================================================
# Znap Plugin Manager
# =============================================================================
[[ -r ~/.znap/znap.zsh ]] ||
    git clone --depth 1 -- https://github.com/marlonrichert/zsh-snap.git ~/.znap
source $HOME/.znap/znap.zsh
zstyle ':znap:*' repos-dir ~/.znap/repos

# Homebrew (macOS or Linux) — output is static per prefix, so cache it
if [[ -x "/opt/homebrew/bin/brew" ]]; then
    znap eval brew '/opt/homebrew/bin/brew shellenv'
elif [[ -x "/home/linuxbrew/.linuxbrew/bin/brew" ]]; then
    znap eval brew '/home/linuxbrew/.linuxbrew/bin/brew shellenv'
elif [[ -x "/usr/local/bin/brew" ]]; then
    znap eval brew '/usr/local/bin/brew shellenv'
fi

# brew's rustup is keg-only; its proxies (cargo, rustc, …) live under opt.
[[ -n "$HOMEBREW_PREFIX" ]] && path=($HOMEBREW_PREFIX/opt/rustup/bin $path)

znap source mattmc3/zephyr plugins/{color,completion,directory,editor,environment,history,utility}
znap source zsh-users/zsh-completions
znap source zsh-users/zsh-autosuggestions

# After the znap source line
zle-line-init() { print -Pn '\e[1 q'; }
zle -N zle-line-init

zle-keymap-select() {
  case $KEYMAP in
    vicmd|visual) print -Pn '\e[1 q' ;;
    *)            print -Pn '\e[1 q' ;;
  esac
}

# =============================================================================
# Environment Variables
# =============================================================================
export APOLLO_TELEMETRY_DISABLED=true

# 1Password SSH agent (Linux socket first, then macOS)
if [[ -S "$HOME/.1password/agent.sock" ]]; then
    export SSH_AUTH_SOCK="$HOME/.1password/agent.sock"
elif [[ -S "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock" ]]; then
    export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
fi
[[ -f ~/.secrets ]] && source ~/.secrets

# ==============================================================================
# Prompt
# ==============================================================================

# myship: starship rendered by a per-user daemon, painted asynchronously so the
# shell never waits on it (built from ~/Projects/myship, symlinked into
# ~/.local/bin). Config is the usual ~/.config/starship.toml. Falls back to
# stock starship on machines without a myship build.
if (( $+commands[myship] )); then
    eval "$(myship init zsh)"
elif (( $+commands[starship] )); then
    eval "$(starship init zsh)"
fi

# ==============================================================================
# Syntax Highlighting
# ==============================================================================

# Patina must remain at the end of this file.
#
# Not cached via `znap eval` on purpose: `activate` has a side effect — it
# starts the highlighter daemon if it is not already running. A cached copy of
# the script only starts the daemon when the cache is regenerated, so after a
# reboot (or a daemon crash) the socket is gone and highlighting silently does
# nothing. Running it every time costs ~20ms.
if (( $+commands[zsh-patina] )); then
    eval "$(zsh-patina activate)"
fi
