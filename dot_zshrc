# .zshrc - Interactive shell configuration

# =============================================================================
# Powerlevel10k instant prompt
# =============================================================================
# Must be the first thing in this file. Paints a cached prompt immediately so
# nothing below blocks first input. Anything after this line that writes to
# the terminal (echo, warnings, prompts for input) will disable it and tell
# you which line did it.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# =============================================================================
# PATH Configuration (consolidated)
# =============================================================================
typeset -U PATH  # Deduplicate PATH entries

# User paths. Toolchains (bun, node, rust, go, erlang/elixir) are on PATH via
# mise below, not here. ~/.cargo/bin stays for `cargo install`ed binaries
# not managed through mise's cargo: backend.
path=(
    $HOME/.local/bin
    $HOME/.cargo/bin
    $HOME/.opencode/bin
    $HOME/bin
    $path
)

# =============================================================================
# Znap Plugin Manager
# =============================================================================
[[ -r ~/.znap/znap.zsh ]] ||
    git clone --depth 1 -- https://github.com/marlonrichert/zsh-snap.git ~/.znap
source $HOME/.znap/znap.zsh
zstyle ':znap:*' repos-dir ~/.znap/repos

# Homebrew (macOS or Linux) — output is static per prefix, so cache it
if [[ -x "/opt/homebrew/bin/brew" ]]; then
    znap eval brew '/opt/homebrew/bin/brew shellenv'
elif [[ -x "/home/linuxbrew/.linuxbrew/bin/brew" ]]; then
    znap eval brew '/home/linuxbrew/.linuxbrew/bin/brew shellenv'
elif [[ -x "/usr/local/bin/brew" ]]; then
    znap eval brew '/usr/local/bin/brew shellenv'
fi

znap source mattmc3/zephyr plugins/{color,completion,directory,editor,environment,history,utility}
znap source zsh-users/zsh-completions
znap source zsh-users/zsh-autosuggestions

# After the znap source line
zle-line-init() { print -Pn '\e[1 q'; }
zle -N zle-line-init

zle-keymap-select() {
  case $KEYMAP in
    vicmd|visual) print -Pn '\e[1 q' ;;
    *)            print -Pn '\e[1 q' ;;
  esac
}

# =============================================================================
# Tool Initialization (only if installed)
# =============================================================================

# mise: toolchain versions, per-directory env (replaces direnv), tasks.
# Shell activation rewrites PATH on cd to the real binaries — no shims.
# Global config: ~/.config/mise/config.toml; per-project: mise.toml.
if (( $+commands[mise] )); then
    eval "$(mise activate zsh)"
fi

# =============================================================================
# Environment Variables
# =============================================================================
# 1Password SSH agent (Linux socket first, then macOS)
if [[ -S "$HOME/.1password/agent.sock" ]]; then
    export SSH_AUTH_SOCK="$HOME/.1password/agent.sock"
elif [[ -S "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock" ]]; then
    export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
fi
[[ -f ~/.secrets ]] && source ~/.secrets

# ==============================================================================
# Prompt
# ==============================================================================

# Powerlevel10k. znap clones it into ~/.znap/repos on first run; gitstatusd
# is fetched by p10k itself on first prompt. Segment config lives in ~/.p10k.zsh.
znap source romkatv/powerlevel10k
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# ==============================================================================
# Syntax Highlighting
# ==============================================================================

# Patina must remain at the end of this file.
if (( $+commands[zsh-patina] )); then
    znap eval zsh-patina 'zsh-patina activate'
fi
