{
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "project_panel": {
    "dock": "right",
    "hide_root": false,
    "hide_hidden": false,
    "git_status_indicator": true,
    "diagnostic_badges": true,
    "hide_gitignore": false,
  },
  "ssh_connections": [
    {
      "host": "conhost.lan",
      "args": [],
      "projects": [
        {
          "paths": ["/home/rageltd/mimir"],
        },
      ],
    },
  ],
  "agent_buffer_font_size": 14.0,
  "agent_ui_font_size": 16.0,
  "git_panel": {
    "dock": "right",
    "tree_view": true,
  },
  "agent": {
    "default_model": {
      "provider": "opencode",
      "model": "go/glm-5.1",
      "enable_thinking": false,
    },
    "dock": "left",
    "default_profile": "write",
    "thinking_display": "preview",
    "tool_permissions": {
      "tools": {
        "mcp:cartographer:cartographer_stats": {
          "default": "allow",
        },
        "mcp:cartographer:cartographer_rules": {
          "default": "allow",
        },
        "mcp:cartographer:cartographer_index_project": {
          "default": "allow",
        },
        "mcp:mcp-server-context7:query-docs": {
          "default": "allow",
        },
        "mcp:mcp-server-context7:resolve-library-id": {
          "default": "allow",
        },
        "edit_file": {
          "always_allow": [
            {
              "pattern": "^src/",
            },
          ],
        },
        "create_directory": {
          "default": "allow",
        },
        "fetch": {
          "always_allow": [
            {
              "pattern": "^https?://opencode\\.ai",
            },
            {
              "pattern": "^https?://ai\\-sdk\\.dev",
            },
            {
              "pattern": "^https?://github\\.com",
            },
            {
              "pattern": "^https?://openrouter\\.ai",
            },
            {
              "pattern": "^https?://mintlify\\.com",
            },
            {
              "pattern": "^https?://agentclientprotocol\\.github\\.io",
            },
            {
              "pattern": "^https?://chutes\\.ai",
            },
            {
              "pattern": "^https?://raw\\.githubusercontent\\.com",
            },
          ],
        },
        "mcp:Cartographer:cartographer_rules": {
          "default": "allow",
        },
        "mcp:Cartographer:cartographer_project_path": {
          "default": "allow",
        },
        "mcp:Cartographer:cartographer_stats": {
          "default": "allow",
        },
        "mcp:Cartographer:cartographer_index_project": {
          "default": "allow",
        },
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^pwd\\b",
            },
            {
              "pattern": "^wc\\b",
            },
            {
              "pattern": "^ls\\b",
            },
            {
              "pattern": "^bun\\s+run(\\s|$)",
            },
          ],
        },
      },
    },
    "enable_feedback": false,
    "show_turn_stats": true,
    "expand_edit_card": true, // Show full diffs by default
  },
  "language_models": {
    "openai_compatible": {
      "Mimir": {
        "api_url": "http://mimir.conhost.lan/v1",
        "available_models": [
          {
            "name": "zai-org/GLM-5.1-TEE",
            "display_name": "GLM 5.1 TEE",
            "max_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
            },
          },
          {
            "name": "Qwen/Qwen3.5-397B-A17B-TEE",
            "display_name": "Qwen3.5 397B A17B TEE",
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": false,
              "chat_completions": true,
            },
            "max_tokens": 262144,
          },
          {
            "name": "opencode-go/glm-5.1",
            "display_name": "GLM 5.1 (Go)",
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": true,
              "prompt_cache_key": false,
              "chat_completions": true,
            },
            "max_tokens": 205000,
          },
          {
            "name": "opencode-go/kimi-k2.5",
            "display_name": "Kimi K2.5 (Go)",
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
            },
            "max_tokens": 262144,
            "max_output_tokens": 16384,
            "max_completion_tokens": 262144,
          },
          {
            "name": "opencode-go/minimax-m2.7",
            "display_name": "MiniMax M2.7 (Go)",
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
            },
            "max_tokens": 204800,
            "max_output_tokens": 16384,
            "max_completion_tokens": 131072,
          },
        ],
      },
    },
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
    "mimir-acp": {
      "default_config_options": {
        "model": "claude-code/opus-4-6-1m",
      },
      "favorite_config_option_values": {
        "model": [
          "Qwen/Qwen3.5-397B-A17B-TEE",
          "glm-5.1",
          "minimax-m2.7",
          "claude-code/opus-4-6-1m",
          "glm-5p1",
          "accounts/fireworks/models/deepseek-v4-pro",
          "gemini-3.1-pro",
          "codex/gpt-5.5"
        ],
      },
      "default_model": "claude-code/default",
      "type": "custom",
      "command": "bun",
      "args": ["/Users/rageltd/Projects/mimir/packages/acp/index.ts"],
      "env": {
        "MIMIR_SERVER_URL": "http://mimir.conhost.lan",
        "MIMIR_CARTOGRAPHER_BIN": "/Users/rageltd/Projects/cartographer/target/release/cartographer",
      },
    },
    "opencode": {
      "favorite_config_option_values": {
        "model": ["opencode-go/qwen3.6-plus"],
      },
      "type": "registry",
    },
  },
  "format_on_save": "on",
  "context_servers": {
    "mcp-server-context7": {
      "enabled": true,
      "remote": false,
      "settings": {
        "context7_api_key": "ctx7sk-34950dc9-ea28-4a7b-9f81-c1474e07e921",
      },
    },
    "cartographer": {
      "enabled": false,
      "command": "/Users/rageltd/Projects/cartographer/target/release/cartographer",
      /// The arguments to pass to the MCP server
      "args": [],
      /// The environment variables to set
      "env": {
        "SURREAL_URL": "surreal.conhost.lan",
        "SURREAL_PASSWORD": "changeme",
        "SURREAL_USER": "root",
        "SURREAL_NAMESPACE": "mimir",
        "SURREAL_DB": "mimir",
        "PWD": "${PWD}",
      },
    },
  },
  "icon_theme": "Bearded Icons",
  "theme": "Bearded Theme Monokai Black",
  "base_keymap": "VSCode",
  "terminal": {
    "toolbar": {
      "breadcrumbs": false,
    },
    "dock": "bottom",
    "font_size": 14.0,
    "shell": "system",
  },
  "show_whitespaces": "boundary",
  "show_edit_predictions": true,
  "ensure_final_newline_on_save": true,
  "tab_size": 2,
  "telemetry": {
    "diagnostics": true,
    "metrics": true,
  },
  "ui_font_size": 18,
  "buffer_font_size": 14,
  "buffer_font_family": "Hack Nerd Font Mono",
  "lsp": {
    "solargraph": {
      "settings": {
        "use_bundler": true,
      },
      "initialization_options": {
        "diagnostics": true,
        "formatting": true,
      },
    },
  },
  "inline_code_actions": true,
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": null,
  },
  "diagnostics": {
    "button": true,
    "include_warnings": true,
    "lsp_pull_diagnostics": {
      "enabled": true,
      "debounce_ms": 50,
    },
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 0,
      "max_severity": "error",
    },
  },
  "languages": {
    "Ruby": {
      "language_servers": ["solargraph"],
      "formatter": { "language_server": { "name": "solargraph" } },
      "code_actions_on_format": {
        "source.fixAll.solargraph": true,
        "source.organizeImports.solargraph": true,
      },
    },
    "JavaScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.organizeImports.biome": true,
        "source.fixAll.biome": true,
      },
    },
    "TypeScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.organizeImports.biome": true,
        "source.fixAll.biome": true,
      },
    },
    "TSX": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.organizeImports.biome": true,
        "source.fixAll.biome": true,
      },
    },
    "HTML": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "CSS": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "JSON": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "YAML": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "Markdown": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
  },
  "feature_flags": {
    "acp-beta": "on",
  },
}
