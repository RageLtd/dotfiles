# Bearded Monokai Black theme for Ghostty
# Mirrors the terminal.* block of BeardedBear's official Zed theme
# ("Bearded Theme Monokai Black") so terminal and editor palettes match.

# Background and foreground (Zed terminal.background / terminal.foreground)
background = 141414
foreground = c7c7c7

# Cursor: Zed's player cursor is the text.accent grey (#8f8f8f)
cursor-color = 8f8f8f
cursor-text = 141414

# Selection: Zed uses #8f8f8f at ~15% alpha over #141414
selection-background = 262626
selection-foreground = c7c7c7

# ANSI colors (0-7: normal, 8-15: bright) - verbatim from Zed terminal.ansi.*
palette = 0=#000000
palette = 1=#fc6a67
palette = 2=#a9dc76
palette = 3=#ffd866
palette = 4=#78dce8
palette = 5=#e991e3
palette = 6=#78e8c6
palette = 7=#ffffff
palette = 8=#545454
palette = 9=#fd9b99
palette = 10=#c2e69f
palette = 11=#ffe599
palette = 12=#a4e7ef
palette = 13=#f2bbee
palette = 14=#a4efd8
palette = 15=#e1e1e1

window-theme = dark
