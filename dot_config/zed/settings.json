{
  "language_models": {
    "ollama": {
      "api_url": "https://ollama.com",
    },
  },
  "cli_default_open_behavior": "new_window",
  "diff_view_style": "unified",
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "project_panel": {
    "dock": "right",
    "hide_hidden": false,
    "git_status_indicator": true,
    "diagnostic_badges": true,
    "hide_gitignore": false,
  },
  "ssh_connections": [
    {
      "host": "conhost.lan",
      "args": [],
      "projects": [
        {
          "paths": ["/home/rageltd/mimir"],
        },
      ],
    },
  ],
  "agent_buffer_font_size": 14.0,
  "agent_ui_font_size": 16.0,
  "git_panel": {
    "dock": "right",
    "tree_view": true,
  },
  "tabs": {
    "show_diagnostics": "all",
    "file_icons": true,
    "git_status": true,
  },
  "title_bar": {
    "show_menus": false,
    "show_branch_name": true,
    "show_branch_status_icon": true,
  },
  "use_smartcase_search": true,
  "toolbar": {
    "code_actions": true,
  },
  "minimap": {
    "show": "auto",
  },
  "auto_signature_help": true,
  "redact_private_values": false,
  "agent": {
    "dock": "left",
    "tool_permissions": {
      "tools": {
        "edit_file": {
          "default": "allow",
        },
      },
      "default": "allow",
    },
    "default_profile": "write",
    "expand_edit_card": true,
    "expand_terminal_card": true,
    "thinking_display": "preview",
    "model_parameters": [],
    "default_model": {
      "provider": "Mimir",
      "model": "Qwen/Qwen3.5-392B-A17B-TEE",
    },
  },
  "agent_servers": {
    "Mimir": {
      "favorite_config_option_values": {
        "model": [
          "ollama-cloud/glm-5.1",
          "ollama-cloud/minimax-m3",
          "ollama-cloud/kimi-k2.7-code"
        ]
      },
      "default_config_options": {
        "model": "ollama-cloud/glm-5.1"
      },
      "type": "custom",
      "command": "bun",
      "args": ["run", "/Users/rageltd/Projects/mimir/packages/acp/index.ts"],
      "env": {
        "MIMIR_SERVER_URL": "http://mimir.conhost.lan",
      },
    },
    "codex-acp": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
    "opencode": {
      "type": "registry",
    },
  },
  "format_on_save": "on",
  "context_servers": {
    "mcp-server-context7": {
      "enabled": true,
      "remote": false,
      "settings": {
        "context7_api_key": "ctx7sk-34950dc9-ea28-4a7b-9f81-c1474e07e921",
      },
    },
    "cartographer": {
      "enabled": false,
      "command": "cartographer",
      /// The arguments to pass to the MCP server
      "args": [],
      /// The environment variables to set
      "env": {
        "SURREAL_URL": "surreal.conhost.lan",
        "SURREAL_PASSWORD": "changeme",
        "SURREAL_USER": "root",
        "SURREAL_NAMESPACE": "mimir",
        "SURREAL_DB": "mimir",
        "PWD": "${PWD}",
      },
    },
  },
  "icon_theme": "Bearded Icons",
  "theme": "Bearded Theme Monokai Black",
  "base_keymap": "VSCode",
  "terminal": {
    "toolbar": {
      "breadcrumbs": false,
    },
    "dock": "bottom",
    "font_size": 14.0,
    "shell": "system",
  },
  "show_whitespaces": "boundary",
  "show_edit_predictions": true,
  "ensure_final_newline_on_save": true,
  "tab_size": 2,
  "telemetry": {
    "diagnostics": true,
    "metrics": true,
  },
  "ui_font_size": 18,
  "buffer_font_size": 14,
  "buffer_font_family": "Hack Nerd Font Mono",
  "inline_code_actions": true,
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": null,
  },
  "diagnostics": {
    "button": true,
    "include_warnings": true,
    "lsp_pull_diagnostics": {
      "enabled": true,
      "debounce_ms": 50,
    },
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 0,
      "max_severity": "error",
    },
  },
  "languages": {
    "JavaScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.organizeImports.biome": true,
        "source.fixAll.biome": true,
      },
    },
    "TypeScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.organizeImports.biome": true,
        "source.fixAll.biome": true,
      },
    },
    "TSX": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.organizeImports.biome": true,
        "source.fixAll.biome": true,
      },
    },
    "HTML": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "CSS": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "JSON": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "YAML": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "Markdown": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
  },
}
